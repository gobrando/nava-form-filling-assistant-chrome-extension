{
  "manifest_version": 3,
  "name": "Nava Form-Filling Assistant",
  "version": "0.11.0",
  "description": "A multi-agent form assistant with on-device and paired subscription runtimes that fills verified values and leaves submission to the caseworker.",
  "minimum_chrome_version": "138",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "action": {
    "default_title": "Open Form-Filling Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/form-engine.js",
        "shared/site-adapters.js",
        "content/form-agent.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
